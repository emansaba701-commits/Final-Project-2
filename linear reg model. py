import pandas as pd
import numpy as np
df=pd.read_csv(r"/storage/emulated/0/Download/archive (10)/bengaluru_house_prices.csv")
print(df)
print(df.head(5))
print(df.columns)
df.drop(columns=["area_type","availability","society"],inplace=True)
print(df)
df.dropna(inplace=True)
print(df)
print(df.location.value_counts())
#print("+"*49)
df["location"] =df["location"].apply(lambda x:x.strip())
print(df.location.value_counts)
location_stats=df.groupby("location")["location"].agg("count").sort_values(ascending=False)
print(location_stats)
locations_lessthan_10_enteries=location_stats[location_stats<=10]
print(locations_lessthan_10_enteries)
df["location"]=df["location"].apply(lambda x:"other" if x in locations_lessthan_10_enteries else x)
print(df.location.value_counts())
print(df)
print(df["size"].unique())
df["bedroom"]=df["size"].apply(lambda x:int(x.split(" ")[0]))
print(df)
print(df["total_sqft"].unique())
def clean(sqft):
    tokens=sqft.split("-")
    if len(tokens)==2:
        return (float(tokens[0]) +float(tokens[1]))/2
    else:
        try:
              return float(sqft)
        except:
             return None     
df["total_sqft"] = df["total_sqft"] .apply(clean)
print(df["total_sqft"].unique())
print(df.dropna(inplace=True))
print(df.describe())
df["sqft_per_bed"]=df["total_sqft"]/df["bedroom"]
print(df)
print(df.sqft_per_bed.describe())
df2=df[df["sqft_per_bed"]>=300]
print(df2)
df2["price_per_sqft"]=round(df2["price"]*100000/df2["total_sqft"],2)
print(df2)
print(df2["price_per_sqft"].describe())
df3=df2[df2["price_per_sqft"]>=2000]
print(df3)
df3.drop(columns=["size","sqft_per_bed","price_per_sqft"],inplace=True)
print(df3)
from sklearn.preprocessing import OneHotEncoder,StandardScaler
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.pipeline import make_pipeline
from sklearn.compose import make_column_transformer


col_trans = make_column_transformer((OneHotEncoder(sparse_output=False),['location']))
lr = LinearRegression()
scaler = StandardScaler()
model = make_pipeline(col_trans,scaler,lr)
data_input=df3.drop(columns=["price"])
data_output=df3["price"]
x_train,x_test,y_train,y_test=train_test_split(data_input,data_output,test_size=0.2)
model.fit(x_train,y_train)
print(model)
print(model.score(x_test,y_test))
input=pd.DataFrame([["Electronic City Phase II",1500,3.0,2.0,0.3]],columns=["location","total_sqft","bath","balcony","bedroom"])
print(model.predict(input))
import pickle as pk
pk.dump(model,open("House_prediction_model.pkl","wb"))
df3.to_csv("Cleaned_data.csv")